<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system bars take the colour of the app instead of the default blue. -->
    <style name="WavelaneTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#0c0d11</item>
        <item name="android:navigationBarColor">#0c0d11</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
