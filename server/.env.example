# Wavelane server configuration. Copy to .env and edit.

WAVELANE_SECRET_KEY=change-me-to-a-long-random-string
WAVELANE_DATABASE_URL=sqlite+aiosqlite:///./wavelane.db
# Postgres example:
# WAVELANE_DATABASE_URL=postgresql+asyncpg://wavelane:password@localhost:5432/wavelane

WAVELANE_STORAGE_ROOT=./storage
WAVELANE_ACCESS_TOKEN_TTL_MINUTES=30
WAVELANE_REFRESH_TOKEN_TTL_DAYS=60
WAVELANE_ALLOW_REGISTRATION=true
WAVELANE_CORS_ORIGINS=["http://localhost:3000"]

# Path to ffmpeg/ffprobe for DSP audio analysis. Leave empty to rely on metadata only.
WAVELANE_FFMPEG_PATH=
WAVELANE_FFPROBE_PATH=
